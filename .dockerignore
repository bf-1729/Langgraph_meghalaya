# Secrets — never bake into an image layer. Pass at run time with --env-file.
.env
.env.bak-*
.env.example

# VCS / tooling
.git
.gitignore
.github
.claude
.venv
__pycache__
**/__pycache__
*.pyc
.mypy_cache
.pytest_cache

# Local runtime artefacts
logs/*
!logs/.gitkeep
fastembed_cache/

# Local dev TLS material (certs/local/dev-key.pem, 2026-10-04). The image needs
# only the internal CA bundle that certs/ otherwise holds; a private key must
# never enter an image layer, where it survives every later deletion.
certs/local/

# Docs / deploy scaffolding not needed inside the app image
docs
deploy
tests
archive
README.md
Dockerfile
docker-compose.yml
.dockerignore

# Predecessor project kept on disk for reference only
NeuralAiGovernanceProject*/
NeuralAiGovernanceProject*.zip
